{
  "name": "pi-context-plugin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Pi extension that receives explicit VS Code context attachments.",
  "exports": "./src/index.ts",
  "pi": {
    "extensions": ["./src/index.ts"]
  },
  "scripts": {
    "build": "tsc -p .",
    "check": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.test.json",
    "test": "tsc -p tsconfig.test.json && node --test .generated-tests/test/*.test.js"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@earendil-works/pi-tui": "0.84.1",
    "@pi-context/protocol": "workspace:*",
    "@toon-format/toon": "4.1.1",
    "effect": "3.22.1"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  }
}
